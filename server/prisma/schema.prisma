// QueueSmart database schema.
// SQLite does not support enums, so enum-like fields are strings; the allowed
// values are listed in the comments and enforced by API validation and the
// SQLite triggers in constraints.js (installed by npm run db:constraints).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Login data only. Passwords are stored as bcrypt hashes, never as plain text.
model UserCredentials {
  id                Int      @id @default(autoincrement())
  email             String   @unique // the username
  passwordHash      String
  role              String   @default("USER") // USER | ADMIN
  emailVerified     Boolean  @default(false)
  verificationToken String?  @unique
  createdAt         DateTime @default(now())

  profile       UserProfile?
  queueEntries  QueueEntry[]
  notifications Notification[]
}

// Personal details and preferences, linked to the login by email.
model UserProfile {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  fullName          String // at most 50 characters (checked in src/validation)
  phone             String? // optional, at most 20 characters
  almostReadyAlerts Boolean  @default(true) // preference: "almost ready" / "you're next" notices
  updatedAt         DateTime @updatedAt

  credentials UserCredentials @relation(fields: [email], references: [email], onDelete: Cascade, onUpdate: Cascade)
}

model Service {
  id               Int      @id @default(autoincrement())
  name             String
  description      String
  expectedDuration Int // minutes per person
  priority         String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  location         String?
  contact          String?
  hours            String?
  category         String   @default("Other")
  maxCapacity      Int? // null means no queue capacity limit
  instructions     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  queue Queue?
}

// One persistent queue per service. Closing it prevents new joins.
model Queue {
  id        Int      @id @default(autoincrement())
  serviceId Int      @unique
  status    String   @default("OPEN") // OPEN | CLOSED
  createdAt DateTime @default(now())

  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  entries QueueEntry[]
}

// Ticket identity and queue position; visit details live in History.
model QueueEntry {
  id              Int      @id @default(autoincrement())
  queueId         Int
  userId          Int
  position        Int? // 1-based while waiting; null once finished
  ticketId        String?
  initialPosition Int?
  joinedAt        DateTime @default(now())
  status          String   @default("WAITING") // WAITING | SERVED | CANCELED

  queue   Queue           @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user    UserCredentials @relation(fields: [userId], references: [id], onDelete: Cascade)
  history History?

  @@index([queueId, status, position])
  @@index([userId])
}

// One record per finished visit. Entry ID is also the visit ID used by the API.
model History {
  entryId     Int       @id
  status      String // SERVED | LEFT | NO_SHOW (cancellation reason)
  servedAt    DateTime?
  completedAt DateTime  @default(now())
  problem     String    @default("")
  outcome     String?
  notes       String    @default("")

  entry QueueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([completedAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  kind      String   @default("info") // confirmed | almost | served | left | joined | queue-active | capacity
  title     String   @default("")
  message   String
  serviceId Int?
  ticketId  String?
  entryId   Int? // queue entry the notice is about; repeat alerts follow position changes
  status    String   @default("SENT") // SENT | VIEWED
  createdAt DateTime @default(now())

  user UserCredentials @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
